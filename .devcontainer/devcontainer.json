{
  "name": "cncf-certification",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "hostRequirements": { "cpus": 4, "memory": "8gb", "storage": "32gb" },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": { "version": "latest", "helm": "latest", "minikube": "none" },
    "ghcr.io/mpriscella/features/kind:1": {},
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12", "installTools": false }
  },
  "postCreateCommand": "echo 'alias k=kubectl' >> ~/.bashrc && echo 'export PATH=$PATH:'$PWD'/bin' >> ~/.bashrc && echo 'source <(kubectl completion bash); complete -o default -F __start_kubectl k' >> ~/.bashrc",
  "postStartCommand": "echo '클러스터: q cluster up   |   문제: q list' ",
  "customizations": {
    "vscode": {
      "extensions": ["ms-kubernetes-tools.vscode-kubernetes-tools", "redhat.vscode-yaml", "bierner.markdown-preview-github-styles"],
      "settings": { "terminal.integrated.defaultProfile.linux": "bash" }
    }
  }
}
