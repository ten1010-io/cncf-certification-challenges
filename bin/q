#!/usr/bin/env bash
# q — 문제/모의고사 실행 CLI
#
#   q list [cka|ckad] [--domain D] [--difficulty easy|medium|hard]
#   q start <id>            문제 환경 구성 (setup.sh) + 문제 파일 경로 출력
#   q check [id]            채점 (생략 시 마지막 start 한 문제)
#   q reset [id]            문제 환경 정리
#   q show [id]             지문 다시 출력
#   q solution [id]         풀이 출력 (스포일러)
#   q exam start <exam>     모의고사 시작: 문항 setup 전부 실행, 통합 문제지 생성, 타이머 시작
#   q exam check <exam>     모의고사 채점: 문항 check 전부 실행, 합산, 합격 판정
#   q exam reset <exam>     모의고사 정리
#   q cluster up|down       kind 클러스터 생성/삭제
#
#   메인테이너용 (gh CLI 필요):
#   q issue list            'new-question' 라벨 열린 이슈 목록
#   q issue take <N>        이슈 N 의 폼으로 문제 폴더 생성 → 브랜치 → 커밋 → push → PR
#   q issue take <N> --no-pr   push/PR 없이 로컬 브랜치까지만
#
# <id> 는 4자리 (0013) 또는 숫자(13). <exam> 은 cka/exams/exam-01.yml 의 "exam-01" 또는 "cka/exam-01".
set -uo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_ROOT="${CNCF_STATE:-/tmp/cncf-state}"
OUT="${CNCF_OUT:-/tmp/cncf-out}"

die() { echo "error: $*" >&2; exit 1; }
yml() { grep -E "^$2:" "$1" 2>/dev/null | head -1 | sed -E "s/^$2:[[:space:]]*//; s/^[\"']//; s/[\"']$//"; }

find_q() { # find_q <id> -> 디렉토리
  local id; id=$(printf '%04d' "$((10#${1//[^0-9]/}))") || die "잘못된 id: $1"
  local d; d=$(ls -d "$ROOT"/*/questions/"$id"-* 2>/dev/null | head -1)
  [[ -n "$d" ]] || die "문제 $id 없음"
  echo "$d"
}
find_exam() { # find_exam <exam> -> yml 경로
  local e="$1" f
  if [[ "$e" == */* ]]; then f="$ROOT/${e%%/*}/exams/${e##*/}.yml"; else f=$(ls "$ROOT"/*/exams/"$e".yml 2>/dev/null | head -1); fi
  [[ -f "$f" ]] || die "모의고사 $e 없음"
  echo "$f"
}
exam_questions() { sed -n '/^questions:/,$p' "$1" | grep -E '^[[:space:]]*-[[:space:]]*[0-9]+' | sed -E 's/^[[:space:]]*-[[:space:]]*([0-9]+).*/\1/'; }

cmd_list() {
  local cert="" domain="" diff=""
  while [[ $# -gt 0 ]]; do case "$1" in --domain) domain="$2"; shift 2;; --difficulty) diff="$2"; shift 2;; *) cert="$1"; shift;; esac; done
  printf '%-5s %-7s %-16s %-4s %s\n' ID DIFF DOMAIN PTS TITLE
  for info in "$ROOT"/${cert:-*}/questions/*/info.yml; do
    [[ -f "$info" ]] || continue
    local d p t di do_
    di=$(yml "$info" difficulty); do_=$(yml "$info" domain); p=$(yml "$info" points); t=$(yml "$info" title)
    [[ -n "$domain" && "$do_" != "$domain" ]] && continue
    [[ -n "$diff" && "$di" != "$diff" ]] && continue
    printf '%-5s %-7s %-16s %-4s %s\n' "$(printf '%04d' "$(yml "$info" id)")" "$di" "$do_" "$p" "$t"
  done
}

CUR_FILE="$STATE_ROOT/current"
cur_id() { # 인자 없으면 마지막 q start 한 문제
  if [[ -n "${1:-}" ]]; then echo "$1"; elif [[ -s "$CUR_FILE" ]]; then cat "$CUR_FILE"; else die "문제 번호 없음. 예: q start 13"; fi
}
wait_cluster() { # 클러스터 준비 대기 (post-start 가 백그라운드로 만드는 중일 수 있음)
  local i=0
  until kubectl --context kind-cka get no >/dev/null 2>&1; do
    [[ $i -eq 0 ]] && echo "클러스터 준비 중... (로그: tail -f /tmp/cncf-cluster.log). 없으면 'q cluster up'"
    i=$((i+1)); [[ $i -gt 120 ]] && die "클러스터 없음. q cluster up 실행"
    sleep 5
  done
}

cmd_start() {
  local d; d=$(find_q "$1") || exit 1
  wait_cluster
  echo "==> setup: $(basename "$d")"
  bash "$d/setup.sh" || die "setup 실패"
  mkdir -p "$STATE_ROOT"; basename "$d" | cut -c1-4 > "$CUR_FILE"
  echo; echo "──────────────────────────────────────────────"
  python3 "$ROOT/scripts/strip-markers.py" "$d/README.md" --no-run
  echo "──────────────────────────────────────────────"
  echo "채점: q check    풀이: q solution    다시 보기: q show"
}
cmd_check() { local d; d=$(find_q "$(cur_id "${1:-}")") || exit 1; bash "$d/check.sh" | grep -v '^RESULT '; }
cmd_reset() { local d; d=$(find_q "$(cur_id "${1:-}")") || exit 1; bash "$d/cleanup.sh"; echo "reset: $(basename "$d")"; }
cmd_show() { local d; d=$(find_q "$(cur_id "${1:-}")") || exit 1; python3 "$ROOT/scripts/strip-markers.py" "$d/README.md"; }
cmd_solution() { local d; d=$(find_q "$(cur_id "${1:-}")") || exit 1; cat "$d/solution.md"; }

exam_dirs_ordered() { # setup_order 오름차순 (disruptive 는 마지막)
  local f="$1" id d
  for id in $(exam_questions "$f"); do d=$(find_q "$id") || exit 1; echo "$(yml "$d/info.yml" setup_order) $d"; done | sort -n | awk '{print $2}'
}

cmd_exam_start() {
  local f; f=$(find_exam "$1") || exit 1
  local name; name=$(basename "$f" .yml); local cert; cert=$(basename "$(dirname "$(dirname "$f")")")
  local dur; dur=$(yml "$f" duration_minutes); dur=${dur:-120}
  local paper="$OUT/$cert-$name-questions.md"
  mkdir -p "$OUT" "$STATE_ROOT"
  echo "==> $cert/$name 환경 구성 ($(exam_questions "$f" | wc -l | tr -d ' ')문항)"
  for d in $(exam_dirs_ordered "$f"); do echo "  - $(basename "$d")"; bash "$d/setup.sh" >/dev/null || die "setup 실패: $d"; done
  {
    echo "# $(yml "$f" title)"; echo
    echo "- 시간: **${dur}분**. 결과 파일은 \`$OUT/\` 에 저장. 문서는 kubernetes.io 만."
    echo "- 노드 접속: \`docker exec -it cka-worker bash\` (시험의 ssh). 작업 후 \`exit\`."
    echo "- 채점: \`q exam check $1\`"; echo; echo "---"; echo
    local n=0 id d pts title
    for id in $(exam_questions "$f"); do
      n=$((n+1)); d=$(find_q "$id"); pts=$(yml "$d/info.yml" points); title=$(yml "$d/info.yml" title)
      echo "## Q$n. $title — ${pts}%  <sub>($(basename "$d"))</sub>"; echo
      python3 "$ROOT/scripts/strip-markers.py" "$d/README.md" --no-run | sed -E 's/^## 문제$//' | sed '/./,$!d'
      echo; echo "---"; echo
    done
  } > "$paper"
  date +%s > "$STATE_ROOT/$cert-$name.start"
  echo
  echo "문제지: $paper"
  echo "시작 시각 기록됨. ${dur}분 후 'q exam check $1'."
}

cmd_exam_check() {
  local f; f=$(find_exam "$1") || exit 1
  local name; name=$(basename "$f" .yml); local cert; cert=$(basename "$(dirname "$(dirname "$f")")")
  local pass_pct; pass_pct=$(yml "$f" pass_percent); pass_pct=${pass_pct:-66}
  local total=0 score=0 n=0 id d out line
  echo "==> 채점 중 (기능 테스트 포함, 1~3분)"; echo
  for id in $(exam_questions "$f"); do
    n=$((n+1)); d=$(find_q "$id")
    out=$(bash "$d/check.sh" 2>/dev/null)
    line=$(grep '^RESULT ' <<<"$out" | tail -1)
    score=$((score + $(awk '{print $3}' <<<"$line"))); total=$((total + $(awk '{print $4}' <<<"$line")))
    echo "Q$n $(grep -v '^RESULT ' <<<"$out" | head -1 | sed -E 's/^\[(PASS|FAIL)\] [0-9]+ /[\1] /')"
    grep -v '^RESULT ' <<<"$out" | tail -n +2
  done
  echo; echo "=========================================="
  local pct=0; [[ $total -gt 0 ]] && pct=$((score * 100 / total))
  echo "점수: $score / $total (${pct}%)   합격선 ${pass_pct}%"
  if [[ -f "$STATE_ROOT/$cert-$name.start" ]]; then
    local el=$(( ($(date +%s) - $(cat "$STATE_ROOT/$cert-$name.start")) / 60 )); echo "소요: ${el}분"
  fi
  [[ $pct -ge $pass_pct ]] && echo "결과: PASS" || echo "결과: FAIL"
  echo "=========================================="
  echo "복습: q solution <id>  |  답안 공유: 각 문제 README 의 'Share your Solution'"
}

cmd_exam_reset() {
  local f; f=$(find_exam "$1") || exit 1
  for d in $(exam_dirs_ordered "$f" | tac); do echo "  - reset $(basename "$d")"; bash "$d/cleanup.sh" >/dev/null 2>&1 || true; done
  echo "완료. 네임스페이스 Terminating 끝난 뒤(kubectl get ns) 다시 start."
}


# ---- 메인테이너: 이슈 폼 → 문제 폴더 → PR (로컬에서 실행)
gh_repo() { source "$ROOT/scripts/config.sh"; echo "$REPO"; }

cmd_issue_list() {
  command -v gh >/dev/null || die "gh CLI 필요: brew install gh && gh auth login"
  gh issue list -R "$(gh_repo)" --label new-question --state open \
    --json number,title,author,createdAt \
    --template '{{range .}}#{{.number}}  {{.title}}  (@{{.author.login}}){{"\n"}}{{end}}'
}

cmd_issue_take() {
  local n="${1:?이슈 번호}" nopr=0
  [[ "${2:-}" == "--no-pr" ]] && nopr=1
  command -v gh >/dev/null || die "gh CLI 필요: brew install gh && gh auth login"
  local repo; repo=$(gh_repo)
  local branch="question/issue-$n"

  git -C "$ROOT" diff --quiet && git -C "$ROOT" diff --cached --quiet \
    || die "커밋되지 않은 변경이 있다. 먼저 정리하고 다시 실행."
  local orig; orig=$(git -C "$ROOT" rev-parse --abbrev-ref HEAD)

  echo "==> 이슈 #$n 가져오는 중"
  local body="$STATE_ROOT/issue-$n.md"; mkdir -p "$STATE_ROOT"
  gh issue view "$n" -R "$repo" --json body --jq .body > "$body" || die "이슈 조회 실패"
  local author; author=$(gh issue view "$n" -R "$repo" --json author --jq .author.login)

  echo "==> 폼 검증"
  python3 "$ROOT/scripts/issue-to-question.py" "$body" --dry-run --root "$ROOT" >/dev/null || die "폼 검증 실패 (위 오류 참고)"

  echo "==> 브랜치 $branch 준비 (origin/main 기준)"
  git -C "$ROOT" fetch -q origin
  git -C "$ROOT" branch -D "$branch" >/dev/null 2>&1 || true
  git -C "$ROOT" switch -q -c "$branch" origin/main || die "브랜치 생성 실패"

  echo "==> 문제 폴더 생성"
  local out; out=$(python3 "$ROOT/scripts/issue-to-question.py" "$body" --root "$ROOT") || {
    git -C "$ROOT" switch -q "$orig"; die "생성 실패"; }
  local qid qdir qtitle
  qid=$(sed -n 's/^id=//p' <<<"$out"); qdir=$(sed -n 's/^dir=//p' <<<"$out"); qtitle=$(sed -n 's/^title=//p' <<<"$out")
  echo "    $qdir"

  echo "==> lint + README 생성"
  bash "$ROOT/scripts/lint-questions.sh" || { git -C "$ROOT" switch -q "$orig"; die "lint 실패"; }
  REPO="$repo" bash "$ROOT/scripts/gen-readme.sh" >/dev/null

  git -C "$ROOT" add -A
  git -C "$ROOT" commit -q -m "feat: 새 문제 $qid $qtitle (#$n)

이슈 #$n 의 폼으로 생성. 제안자 @$author.

Closes #$n"

  if [[ $nopr -eq 1 ]]; then
    echo; echo "브랜치 $branch 에 커밋 완료 (push/PR 안 함)."
    echo "확인: git show --stat"
    echo "되돌리기: git switch $orig && git branch -D $branch"
    return
  fi

  echo "==> push"
  git -C "$ROOT" push -q --force-with-lease -u origin "$branch" || { git -C "$ROOT" switch -q "$orig"; die "push 실패"; }

  echo "==> PR 생성"
  local url
  url=$(gh pr create -R "$repo" --base main --head "$branch" \
    --title "feat: 새 문제 $qid — $qtitle" \
    --label new-question \
    --body "이슈 #$n 의 폼으로 생성된 문제.

- 폴더: \`$qdir\`
- 제안자: @$author

Closes #$n") || { git -C "$ROOT" switch -q "$orig"; die "PR 생성 실패"; }

  gh issue comment "$n" -R "$repo" --body "### ✅ 문제 $qid 생성됨

PR: $url
폴더: \`$qdir\`

리뷰 후 머지되면 문제 목록에 추가된다." >/dev/null || true

  git -C "$ROOT" switch -q "$orig"
  echo; echo "완료. PR: $url"
  echo "로컬 검증하려면: git switch $branch && q start ${qid#0} && q check"
}

case "${1:-}" in
  list) shift; cmd_list "$@";;
  start) cmd_start "${2:?id (예: q start 13)}";;
  check) cmd_check "${2:-}";;
  reset) cmd_reset "${2:-}";;
  show) cmd_show "${2:-}";;
  solution) cmd_solution "${2:-}";;
  exam) case "${2:-}" in start) cmd_exam_start "${3:?exam}";; check) cmd_exam_check "${3:?exam}";; reset) cmd_exam_reset "${3:?exam}";; *) sed -n '2,20p' "$0";; esac;;
  issue) case "${2:-}" in
      list) cmd_issue_list;;
      take) cmd_issue_take "${3:?이슈 번호 (예: q issue take 1)}" "${4:-}";;
      *) sed -n '2,24p' "$0";; esac;;
  cluster) case "${2:-}" in up) bash "$ROOT/common/setup/create-cluster.sh";; down) bash "$ROOT/common/setup/destroy-cluster.sh";; *) echo "q cluster up|down";; esac;;
  ""|help|-h|--help) sed -n '2,20p' "$0"; echo; cmd_list;;
  *) sed -n '2,20p' "$0";;
esac
